# Seguridad
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=pon-aqui-una-clave-secreta-larga
# En produccion con HTTPS activa la cookie solo-https
#SESSION_HTTPS_ONLY=true
# Desactivar el scheduler de sincronizacion (solo para tests)
#ENABLE_SCHEDULER=true

# URL publica de la app (produccion). Ej: https://tudominio.com
# En local se deja vacio y se usa http://localhost:8000
#PUBLIC_BASE_URL=https://tudominio.com

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID Web)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
# Emails con rol de administrador (separados por coma). Vacio = nadie es admin.
ADMIN_EMAILS=tu@email.com

# Base de datos (SQLite). Relativa al directorio de trabajo:
# en local es ./data/tradein.db y en Docker /app/data/tradein.db (mismo valor).
DATABASE_URL=sqlite:///./data/tradein.db

# Coeficientes de compra
# Efectivo: precio LOW * COEF_CASH
# Dinero de tienda: precio LOW * COEF_STORE (= 0.7 * 1.15)
COEF_CASH=0.7
COEF_STORE=0.805

# Juegos soportados (idGame de Cardmarket): 1=MTG, 6=Pokemon, 18=One Piece, 24=Gundam
SUPPORTED_GAMES=1,6,18,24

# Si el precio actual varia mas de este % respecto al snapshot, la linea se marca para revision
PRICE_ALERT_PCT=10
# Horas que un precio cacheado se considera vigente
PRICE_CACHE_TTL_HOURS=24
# Hora de sincronizacion diaria con Cardmarket (HH:MM)
SYNC_TIME=03:30
# Zona horaria del scheduler
SYNC_TIMEZONE=Europe/Madrid

# Timezone
TZ=Europe/Madrid

# Despliegue Docker (convenciones TrueNAS)
# UID/GID del usuario que escribe en ./data
#PUID=1000
#PGID=1000
# IP de escucha del puerto 8002
#BIND_IP=0.0.0.0
